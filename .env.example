# --- La Belle Vie account (LOCAL ONLY) ------------------------------------
# Your labellevie.com login — used ONLY by local tooling (scripts/verify-auth.ts
# and integration tests). The server never reads these: each user connects
# their own account through the connect_account tool's one-time browser link.
# NEVER set on Vercel, never commit, never paste in chat.
LBV_EMAIL=you@example.com
LBV_PASSWORD=your-password

# --- Credential encryption (server) ---------------------------------------
# Key that encrypts connected users' LBV credentials at rest (AES-256-GCM).
# Required in production for the connect_account flow; set it on Vercel
# (Production + Preview, Sensitive). Generate with: openssl rand -hex 32
# Rotating it invalidates every stored connection — users must reconnect.
LBV_CRED_KEY=

# --- MCP server auth ------------------------------------------------------
# Bearer token the MCP server requires from every client. Generate a long
# random string (e.g. `openssl rand -hex 32`). Give the same value to the
# agent's MCP config and to the CLI (LBV_API_TOKEN below).
LBV_API_TOKEN=generate-a-long-random-token

# --- Descope OAuth (Claude Desktop / claude.ai connectors) ----------------
# Optional second auth path alongside LBV_API_TOKEN. Requires the project ID
# plus at least one allowlist key below — the server fails closed otherwise.
# Set them on Vercel (Production + Preview, Sensitive) and redeploy.
# Project ID from the Descope console (not a secret).
DESCOPE_PROJECT_ID=
# THE security boundary: a Descope token is accepted only if it identifies
# this one user — by email claim (case-insensitive) or, when the client's
# grants don't include the email claim, by the Descope user id in `sub`
# (Users page in the console, starts with U). Either match suffices.
LBV_ALLOWED_EMAIL=bernard.pierrejean@gmail.com
LBV_ALLOWED_SUBJECT=
# Optional regional override; defaults to https://api.descope.com
# DESCOPE_BASE_URL=
# Local descope CLI only (provisioning). NEVER set on Vercel, never commit,
# never paste in chat — the server runtime does not use it.
# DESCOPE_MANAGEMENT_KEY=

# --- Session store (Vercel KV / Upstash Redis) ----------------------------
# Cookie jars, account connections, one-time connect links + MCP SSE state.
# REQUIRED in production: connect links and connections must be visible across
# serverless instances. On Vercel, adding a KV/Upstash store injects these
# automatically. If absent, an in-memory fallback is used (local dev only).
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Used by mcp-handler for SSE stream resumability (a redis:// URL).
REDIS_URL=

# --- CLI ------------------------------------------------------------------
# Where the thin CLI connects. Point at the deployed server in production.
LBV_MCP_URL=http://localhost:3000/mcp
